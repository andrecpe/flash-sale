# Normalização de fim de linha
* text=auto

# Scripts executados dentro de containers Linux: sempre LF
*.sh   text eol=lf
mvnw   text eol=lf
*.conf text eol=lf
*.json text eol=lf
*.yml  text eol=lf

# Scripts Windows: sempre CRLF
*.cmd  text eol=crlf
*.bat  text eol=crlf
*.ps1  text eol=crlf

# Binários
*.jar  binary
*.png  binary

