# Copie para .env e ajuste se necessário. Todos os valores abaixo já são os padrões
# usados pelo docker-compose.yml — o projeto roda SEM o arquivo .env.

# Portas expostas no host
GATEWAY_PORT=8080
GRAFANA_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672

# PostgreSQL (apenas desenvolvimento local)
POSTGRES_PASSWORD=postgres
CHECKOUT_DB_PASSWORD=checkout
ORDER_DB_PASSWORD=order

# Checkout: estoque inicial da campanha (cadastrado na subida; não sobrescreve saldo existente no Redis)
ESTOQUE_INICIAL=PROD-001:100,PROD-002:10

# Order Processor: probabilidade de falha simulada (0.0 a 1.0).
# Pedidos com cliente_nome contendo "FALHA" falham sempre.
FAILURE_RATE=0.3

# Imagem do backend de observabilidade (fixe uma tag para builds reprodutíveis)
OTEL_LGTM_IMAGE=grafana/otel-lgtm:latest

# RabbitMQ: usuário/senha de desenvolvimento definidos em infra/rabbitmq/definitions.json
#   usuário: flashsale   senha: flashsale

